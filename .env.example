# OpenRouter API Key — usada por llm_client.py para todas as chamadas de LLM
# (adaptação de currículo, geração de materiais, parsing de vagas para o grafo).
# Obtenha uma chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_de_api_aqui

# Modelo usado nas chamadas de LLM via OpenRouter. Opcional — se omitido, usa o
# default de llm_client.py (anthropic/claude-opus-5). Para reduzir custo, troque
# por algo como google/gemini-3.5-flash-lite. Veja modelos com suporte a
# structured_outputs em: https://openrouter.ai/models?supported_parameters=structured_outputs
OPENROUTER_MODEL=anthropic/claude-opus-5
